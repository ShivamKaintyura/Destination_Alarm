<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DestinationAlarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launcher_bg</item>
    </style>

    <style name="Theme.DestinationAlarm.Alarm" parent="Theme.DestinationAlarm">
        <item name="android:windowBackground">#120506</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
